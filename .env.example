# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/groundupbjj"

# For development, you can also use SQLite:
# DATABASE_URL="file:./dev.db"

# PostgreSQL connection details (if using separate vars)
PGDATABASE="groundupbjj"
PGHOST="localhost"
PGPORT="5432"
PGUSER="username"
PGPASSWORD="password"

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..." # Secret key (server-side only)
VITE_STRIPE_PUBLIC_KEY="pk_test_..." # Publishable key (client-side safe)

# Stripe Webhook Secret
# Get this from your Stripe webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Stripe Price ID for subscriptions (if implementing memberships later)
# STRIPE_PRICE_ID="price_..."

# NextAuth/Session Configuration
SESSION_SECRET="your-super-secret-session-key-here-make-it-long-and-random"

# Admin Configuration
ADMIN_EMAIL="admin@groundupbjj.com"
ADMIN_PASSWORD="ChangeMe123!"

# Email Configuration (using Resend)
# Get API key from https://resend.com/
RESEND_API_KEY="re_..."

# Alternative: Nodemailer SMTP settings
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Application Settings
NODE_ENV="development"
PORT="5000"

# Site Configuration
SITE_URL="http://localhost:5000"
SITE_NAME="Ground Up BJJ"

# Optional: Analytics and Monitoring
# GOOGLE_ANALYTICS_ID="GA_MEASUREMENT_ID"
# SENTRY_DSN="your-sentry-dsn"

# Optional: server-side Meta Test Events verification
# Keep these values server-only. META_CONVERSIONS_API_ACCESS_TOKEN must be
# stored as a Replit Secret or supplied by an approved server connection.
# The route is disabled until all values below are explicitly configured.
# META_SERVER_TEST_ENABLED="true"
# META_CONVERSIONS_API_ACCESS_TOKEN="..." # server secret only
# META_CONVERSIONS_API_PIXEL_ID="..."
# META_CONVERSIONS_API_TEST_EVENT_CODE="..."
# META_CONVERSIONS_API_VERSION="v21.0"

# Optional: File Upload (if implementing file uploads later)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_S3_BUCKET="your-bucket-name"
# AWS_REGION="us-east-1"

# Optional: Calendar Integration
# GOOGLE_CALENDAR_CLIENT_ID="your-client-id"
# GOOGLE_CALENDAR_CLIENT_SECRET="your-client-secret"

# Development Settings
# Set to true to enable debug logging
DEBUG="false"

# Rate Limiting (requests per minute per IP)
RATE_LIMIT="100"

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5000"

# Replit Configuration (automatically set in Replit environment)
# REPLIT_DOMAINS will be set automatically by Replit
# REPL_ID will be set automatically by Replit
